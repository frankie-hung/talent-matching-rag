# DeepSeek is the default LLM provider (OpenAI-compatible API).
# Copy this file to .env and fill in the key. Never commit .env.
# Leave the key blank to run mock ranking (vectors and grounding still work).

DEEPSEEK_API_KEY=
# Optional. Default DeepSeek OpenAI-compatible endpoint:
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Chat model. deepseek-reasoner is the optional reasoning model.
DEEPSEEK_MODEL=deepseek-chat

# Embeddings stay local. DeepSeek does not serve this demo's embedding model.
# Sentence-transformers / Hugging Face id. The app runs an ONNX build of this model.
# If this value changes, delete .chroma or re-run ingest before searching.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Persistent Chroma directory (gitignored).
CHROMA_PATH=.chroma
