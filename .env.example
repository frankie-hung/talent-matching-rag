# DeepSeek is the default LLM provider (OpenAI-compatible API).
# Copy this file to .env and fill in the key. Never commit .env.

DEEPSEEK_API_KEY=
# Optional. Default DeepSeek OpenAI-compatible endpoint:
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Chat model. deepseek-reasoner is the optional reasoning model.
DEEPSEEK_MODEL=deepseek-chat
